# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Vercel Deployment URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# GROQ API key — https://console.groq.com/keys
GROQ_API_KEY=your-real-key

# Google OAuth (for Auth)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Supabase service role key — Project Settings > API > service_role secret.
# Server-side only (Telegram webhook), NEVER expose as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram bot — created via @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Any random string you choose — verifies webhook requests really come from Telegram
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
# Bot username without @, used to build the t.me deep link
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# Performance
NEXT_DISABLE_TURBOPACK=1